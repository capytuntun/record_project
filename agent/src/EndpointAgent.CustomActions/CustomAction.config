<?xml version="1.0" encoding="utf-8" ?>
<!--
  Tells the custom-action host (SfxCA) which CLR to load. Without this file it
  asks for .NET 2.0, which Windows 10/11 do not ship, and every uninstall fails
  with 1603 before the password check even runs.
-->
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" />
  </startup>
</configuration>
