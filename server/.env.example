# Copy to .env and fill in real values. Never commit .env.
# Generate secrets with:  python -c "import secrets; print(secrets.token_urlsafe(64))"

# Signing key for access/refresh JWTs. Required - the app refuses to start without it.
EEM_SECRET_KEY=

# One-time bootstrap secret for creating the initial SUPER_ADMIN.
# Set it, run `flask bootstrap-super-admin`, then REMOVE it from the environment.
EEM_BOOTSTRAP_SECRET=

# SQLite for development. Swap for postgresql+psycopg://... in production.
EEM_DATABASE_URI=sqlite:///eem.db

# Token lifetimes
EEM_ACCESS_TOKEN_TTL_MINUTES=15
EEM_REFRESH_TOKEN_TTL_DAYS=7

# An endpoint is considered OFFLINE after this many seconds without a heartbeat.
EEM_HEARTBEAT_INTERVAL_SECONDS=60
EEM_OFFLINE_AFTER_SECONDS=180

# Set to 1 only behind a trusted reverse proxy that sets X-Forwarded-For.
EEM_TRUST_PROXY_HEADERS=0

EEM_LOG_LEVEL=INFO

# --- Screen recording (optional) ---
# Recording is OFF unless a key is set. Segments are AES-encrypted with a key
# derived from this passphrase; without it, recordings would be written
# unencrypted, so recording simply does not run. Generate a strong value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
EEM_RECORDING_KEY=
# FFmpeg is required to encode. Leave unset on Linux: the system ffmpeg
# (apt install ffmpeg) is found automatically.
# EEM_FFMPEG_PATH=
# EEM_RECORDING_DIR=            # default: instance/recordings
# EEM_RECORDING_SEGMENT_SECONDS=300
# EEM_RECORDING_FPS=5
# EEM_RECORDING_RETENTION_DAYS=30
